# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# SUPABASE_URL: Your Supabase project URL (e.g. https://your-project-ref.supabase.co)
# Configure this via the Secrets panel in AI Studio for Cloud Auto-Sync.
SUPABASE_URL=YOUR_SUPABASE_URL

# SUPABASE_ANON_KEY: Your Supabase project public anon key.
# Configure this via the Secrets panel in AI Studio for Cloud Auto-Sync.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
